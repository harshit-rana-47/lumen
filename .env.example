# Single source of truth for local secrets/config.
# Loaded by the API (env.ts) and by the web app (next.config.mjs → root .env).
# Do not create apps/web/.env or apps/web/.env.local.

# -- App ----------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Required for pg-boss + migration scripts. Must be non-empty locally.
# Supabase → Project Settings → Database → Connection string (URI).
# Paste into root .env only — never commit real credentials.
DATABASE_URL=

# -- Supabase (PostgreSQL + Auth + Storage) ----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# -- Encryption ---------------------------------------------------
MASTER_ENCRYPTION_KEY=

# -- Groq ---------------------------------------------------------
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_WORKER_MODEL=openai/gpt-oss-20b

# -- Local embeddings --------------------------------------------
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
