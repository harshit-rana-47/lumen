# Single source of truth for local secrets/config.
# Loaded by the API (env.ts) and by the web app (next.config.mjs → root .env).
# Do not create apps/web/.env or apps/web/.env.local.

# -- App ----------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Required for pg-boss + migration scripts. Must be non-empty locally.
# Supabase → Project Settings → Database → Connection string (URI).
# On Render/IPv4-only hosts, prefer Session pooler (port 5432), or keep the
# direct db.<ref>.supabase.co URL and set SUPABASE_REGION (e.g. ap-southeast-2)
# so the API can rewrite to the IPv4 pooler automatically.
DATABASE_URL=

# Optional. Used to rewrite IPv6-only Supabase direct DB hosts to the session pooler.
# SUPABASE_REGION=ap-southeast-2
# DATABASE_POOLER_HOST=aws-1-ap-southeast-2.pooler.supabase.com

# -- Supabase (PostgreSQL + Auth + Storage) ----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# -- Encryption ---------------------------------------------------
MASTER_ENCRYPTION_KEY=

# -- Groq ---------------------------------------------------------
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_WORKER_MODEL=openai/gpt-oss-20b

# -- Local embeddings --------------------------------------------
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
