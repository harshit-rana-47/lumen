{
  "name": "@lumen/api",
  "private": true,
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec ts-node src/server.ts",
    "dev:workers": "nodemon --watch src --ext ts,json --exec ts-node src/workers/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:workers": "node dist/workers/index.js",
    "test": "jest --runInBand",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lumen/shared": "file:../../packages/shared",
    "@supabase/supabase-js": "^2.110.0",
    "@upstash/redis": "^1.34.0",
    "@xenova/transformers": "^2.17.2",
    "bullmq": "^5.79.2",
    "cors": "^2.8.6",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "groq-sdk": "^1.3.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jsdom": "^24.1.1",
    "morgan": "^1.11.0",
    "neo4j-driver": "^5.28.3",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "socket.io": "^4.7.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@lumen/eslint-config": "file:../../packages/config/eslint-config",
    "@lumen/tsconfig": "file:../../packages/config/tsconfig",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
